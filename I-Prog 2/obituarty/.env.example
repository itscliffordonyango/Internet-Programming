# Flask secret key - change this to a random string in production
SECRET_KEY=dev-secret-key-change-in-production

# Database URL - default uses SQLite
# For MySQL or PostgreSQL, update accordingly:
# MySQL: mysql+pymysql://username:password@localhost/obituary_platform
# PostgreSQL: postgresql://username:password@localhost/obituary_platform
DATABASE_URL=sqlite:///database/obituary_platform.db

# Application base URL (used for canonical URLs and Open Graph tags)
APP_URL=http://localhost:5000

# Flask environment (development, production, testing)
FLASK_ENV=development

